#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer BiasBuffer {
    float biases[];
};

layout(std430, set = 0, binding = 1) buffer MatrixBuffer {
    float matrixValues[];
};

layout(push_constant) uniform Settings {
    uint rows;
    uint columns;
} settings;

void main() {
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (index >= settings.rows * settings.columns) {
        return;
    }
    matrixValues[index] += biases[index % settings.columns];
}
