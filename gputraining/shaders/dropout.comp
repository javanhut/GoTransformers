#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer ValueBuffer {
    float values[];
};

layout(push_constant) uniform Settings {
    uint count;
    uint seed;
    float rate;
    float keptScale;
} settings;

uint mixBits(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

void main() {
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (index >= settings.count) {
        return;
    }
    uint randomBits = mixBits(index ^ mixBits(settings.seed));
    float randomNumber = float(randomBits >> 8) / 16777216.0;
    if (randomNumber < settings.rate) {
        values[index] = 0.0;
    } else {
        values[index] = values[index] * settings.keptScale;
    }
}
